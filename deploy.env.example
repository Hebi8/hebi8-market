# Settings for scripts/deploy.sh (and release.sh / hotfix.sh --deploy), for this machine only: copy to
# deploy.env in the repo's main checkout (it is not in git). KEY=value, one per line, no quotes; a variable
# set in the environment wins. See docs/self-hosting.md §更新线上实例.

# Where the live instance runs: local (the default) = this checkout, or user@host to deploy over ssh.
#HEBI8_LIVE_HOST=deploy@192.0.2.10
# The live checkout on that machine, relative to its home or absolute.
#HEBI8_LIVE=dev/hebi8-market
# The systemd user unit, the page to check and the secrets dir there, when not the defaults.
#HEBI8_UNIT=hebi8-market
#HEBI8_HEALTH_URL=http://127.0.0.1:3000/
#HEBI8_SECRETS=/home/deploy/.config/hebi8/market
